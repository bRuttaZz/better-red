<?xml version="1.0" encoding="utf-8"?>
<!-- Shown only in the widget picker (sample rows). The real widget is widget_news.xml with a scrollable list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/news_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:maxLines="1"
            android:text="…and the doctor said"
            android:textColor="#FFB3474E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/news_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:textColor="#FF534342"
            android:textSize="13sp" />

        <!-- (plain <View> isn't allowed in widgets, so dividers are FrameLayouts) -->
        <FrameLayout
            android:id="@+id/news_div1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F000000" />

        <LinearLayout
            android:id="@+id/news_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/news_title1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="What counts as a normal cycle length?"
                android:textColor="#FF231919"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/news_meta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Period Education Project · 2h"
                android:textColor="#FF857372"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- (plain <View> isn't allowed in widgets, so dividers are FrameLayouts) -->
        <FrameLayout
            android:id="@+id/news_div2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F000000" />

        <LinearLayout
            android:id="@+id/news_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/news_title2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Iron-rich foods that can help during your period"
                android:textColor="#FF231919"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/news_meta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Period Education Project · 2h"
                android:textColor="#FF857372"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- (plain <View> isn't allowed in widgets, so dividers are FrameLayouts) -->
        <FrameLayout
            android:id="@+id/news_div3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F000000" />

        <LinearLayout
            android:id="@+id/news_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/news_title3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="PMS vs PMDD: how to tell the difference"
                android:textColor="#FF231919"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/news_meta3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Period Education Project · 2h"
                android:textColor="#FF857372"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- (plain <View> isn't allowed in widgets, so dividers are FrameLayouts) -->
        <FrameLayout
            android:id="@+id/news_div4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F000000" />

        <LinearLayout
            android:id="@+id/news_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/news_title4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Why stress can delay your period"
                android:textColor="#FF231919"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/news_meta4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Period Education Project · 2h"
                android:textColor="#FF857372"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
