<?xml version="1.0" encoding="utf-8"?>
<!-- Cycle widget (2×2). Colors and text are set by CycleWidget at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/cycle_ring"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:src="@drawable/widget_ring_preview"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/cycle_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Follicular phase"
            android:textColor="#FF231919"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cycle_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:text="Period in 17 days"
            android:textColor="#FF534342"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
